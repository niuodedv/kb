/*
 * 板级引脚控制
 *
 * WS2812 灯带（worldsemi,ws2812-spi）挂在 SPI2 上：
 *   MOSI = P0.20 (RGB_DATA)
 *   SCK  = P1.10 (哑引脚，对外不接线)
 *
 * ⚠️ WS2812 是单线协议，只用到 MOSI；但 SPIM 外设的 SCK 若不在 pinctrl 里
 *    分配，就不会产生时钟，自然也就没有 MOSI 波形。因此必须给 SCK 分配一个
 *    空闲引脚。P1.10 是暂定值，若与后续屏幕/编码器/ADC 分配冲突，改这里即可，
 *    不影响任何 C 代码。
 * ⚠️ 绝对不要用 P0.00 / P0.01（模块脚 11/13，32.768kHz 晶振 XL1/XL2）。
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 10)>,   /* 哑 SCK：P1.10 */
				<NRF_PSEL(SPIM_MOSI, 0, 20)>;  /* RGB_DATA：P0.20 */
		};
	};

	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 10)>,
				<NRF_PSEL(SPIM_MOSI, 0, 20)>;
			low-power-enable;
		};
	};

	/*
	 * IP5306-I2C：SCL=P0.24 / SDA=P1.00（跨 GPIO 端口，nRF TWIM 支持）。
	 * 板上已有 10k 上拉，这里再开内部上拉加强上升沿。
	 */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 24)>,
				<NRF_PSEL(TWIM_SDA, 1, 0)>;
			bias-pull-up;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 24)>,
				<NRF_PSEL(TWIM_SDA, 1, 0)>;
			low-power-enable;
		};
	};
};
