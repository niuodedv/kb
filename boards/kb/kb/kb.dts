/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "kb-pinctrl.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "kb";
	compatible = "kb,kb";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* LCD 显示设备（ST7789V）：应用层经 display API 直接写屏 */
		zephyr,display = &st7789v;
	};

	/*
	 * WS2812 灯带供电开关：RGB_PWR_EN(P0.13) 高电平使能 RGB_VCC。
	 *
	 * 建模为 fixed regulator 的好处：regulator_enable() 会自动处理
	 * startup-delay-us（上电到数据有效的等待），且带引用计数，
	 * 将来低功耗模块也能安全调用。上电默认断电。
	 */
	rgb_vcc: regulator-rgb-vcc {
		compatible = "regulator-fixed";
		regulator-name = "rgb-vcc";
		enable-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <1000>;
		regulator-boot-off;
	};

	/*
	 * 6 行 x 4 列 按键矩阵（含 EC11 编码器按键）
	 *
	 * 驱动语义（与直觉相反）：列被驱动（输出），行被读取（输入）。
	 * 硬件每键串联 1 只 1N4148W，方向为「列 -> 行」（阴极在行侧），
	 * 因此：行下拉 + 高电平有效，列驱动为高电平有效。
	 * 详见 矩阵按键.txt
	 */
	kbd_matrix: kbd-matrix {
		compatible = "gpio-kbd-matrix";
		status = "okay";

		/* 行 = 输入（被读取）。顺序必须 ROW0 -> ROW5 */
		row-gpios = <&gpio0 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* ROW0 */
			    <&gpio0  7 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* ROW1 */
			    <&gpio0 12 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* ROW2 */
			    <&gpio0  4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* ROW3 */
			    <&gpio1  9 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* ROW4 */
			    <&gpio0  8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>; /* ROW5 */

		/* 列 = 输出（被驱动）。顺序必须 COL0 -> COL3 */
		col-gpios = <&gpio0  5 GPIO_ACTIVE_HIGH>,  /* COL0 */
			    <&gpio0  6 GPIO_ACTIVE_HIGH>,  /* COL1 */
			    <&gpio0 26 GPIO_ACTIVE_HIGH>,  /* COL2 */
			    <&gpio0 30 GPIO_ACTIVE_HIGH>;  /* COL3 */

		/* 每键都有隔离二极管：未选中列直接驱动为无效电平，无需稳定延时 */
		col-drive-inactive;
		settle-time-us = <0>;

		/* 有隔离二极管 => 物理上不会鬼键，关掉检测以支持任意多键同按 */
		no-ghostkey-check;

		/* 稀疏矩阵掩码，每列一个行位掩码（bit n = ROWn 是否存在）：
		 *   COL0: ROW1,2,3,4,5 -> 0b00111110 = 0x3E
		 *   COL1: ROW1,2,3,4,5 -> 0b00111110 = 0x3E
		 *   COL2: ROW1,2,3,4   -> 0b00011110 = 0x1E
		 *   COL3: ROW0,1,3,5   -> 0b00101011 = 0x2B
		 * 置位总数 18 = 17 个机械轴 + 1 个 EC11 编码器按键
		 */
		actual-key-mask = <0x3E 0x3E 0x1E 0x2B>;

		/* 空闲时行 GPIO 挂中断，按下即唤醒；松手 100ms 后退回中断态 */
		idle-mode = "interrupt";
		poll-period-ms = <5>;
		poll-timeout-ms = <100>;
		debounce-down-ms = <10>;
		debounce-up-ms = <20>;

		/* 行列坐标 -> 标准键值。必须是 kbd-matrix 的子节点 */
		kbd_keymap: keymap {
			compatible = "input-keymap";
			row-size = <6>;
			col-size = <4>;
			keymap = <
				MATRIX_KEY(0, 3, INPUT_KEY_MUTE)
				MATRIX_KEY(1, 0, INPUT_KEY_NUMLOCK)
				MATRIX_KEY(1, 1, INPUT_KEY_KPSLASH)
				MATRIX_KEY(1, 2, INPUT_KEY_KPASTERISK)
				MATRIX_KEY(1, 3, INPUT_KEY_KPMINUS)
				MATRIX_KEY(2, 0, INPUT_KEY_KP7)
				MATRIX_KEY(2, 1, INPUT_KEY_KP8)
				MATRIX_KEY(2, 2, INPUT_KEY_KP9)
				MATRIX_KEY(3, 0, INPUT_KEY_KP4)
				MATRIX_KEY(3, 1, INPUT_KEY_KP5)
				MATRIX_KEY(3, 2, INPUT_KEY_KP6)
				MATRIX_KEY(3, 3, INPUT_KEY_KPPLUS)
				MATRIX_KEY(4, 0, INPUT_KEY_KP1)
				MATRIX_KEY(4, 1, INPUT_KEY_KP2)
				MATRIX_KEY(4, 2, INPUT_KEY_KP3)
				MATRIX_KEY(5, 0, INPUT_KEY_KP0)
				MATRIX_KEY(5, 1, INPUT_KEY_KPDOT)
				MATRIX_KEY(5, 3, INPUT_KEY_KPENTER)
			>;
		};
	};
};

/* SoC dtsi 默认把 GPIO 控制器置为 disabled，这里显式使能。
 * 否则 CONFIG_GPIO_NRFX 不会链接，矩阵驱动找不到 gpio0/gpio1 设备对象。 */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* GPIO 中断（矩阵 interrupt 空闲模式）依赖 GPIOTE 外设，SoC dtsi 默认 disabled */
&gpiote0 {
	status = "okay";
};

/*
 * 旋钮 A 相用到 P0.10，但 nRF52840 的 P0.9/P0.10 默认（被配置）走 NFC 天线功能，
 * 会被硬件路由到 NFC 外设、恒为低，无法当 GPIO 用。必须把 NFC 脚改回 GPIO。
 * 改后构建产物会带上 UICR.NFCPINS=1 的设置，由烧录工具写入；烧录后做一次
 * 断电/复位即可生效。
 */
&uicr {
	nfct-pins-as-gpios;
};

/*
 * WS2812 灯带（SPI 方式驱动，17 颗）
 *
 * 时序取值 4MHz + one=0x70 / zero=0x40 是本 SDK 内 Nordic 官方板
 * (actinius_icarus_som_dk) 的在树用法：一位 250ns，'1' 高 750ns、
 * '0' 高 250ns，正好落在驱动文档给的「'0' 200~500ns / '1' >=550ns」窗口内。
 *
 * ⚠️ WS2812 是单线协议只用到 MOSI，但 SPIM 外设必须有 SCK 才会出时钟，
 *    所以 pinctrl 里给 SCK 分配了空闲哑引脚 P0.14（对外不接线）。
 * ⚠️ 屏幕 SPI 用 spi3，避开 spi2。
 */
&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	ws2812: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;                     /* SPI 绑定要求的格式，灯带无片选 */
		spi-max-frequency = <4000000>;
		chain-length = <17>;           /* 18 个键位 - EC11 旋钮按键无灯 */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;   /* WS2812 线上顺序是 GRB */
		reset-delay = <50>;
	};
};

/*
 * LCD 屏幕（ST7789V，320x172，SPI 只写）挂 SPI3（详见 lcd 显示.txt）
 *   SCK = P1.13 (SCREEN_SCL) / MOSI = P0.28 (SCREEN_SDA)
 *   CS  = P0.02，由 SPI 控制器 cs-gpios 管理（低有效，硬接 LCD 的 CS）
 *   DC  = P0.03 / RES = P1.10 / 背光 BLK = P1.11（PWM0）
 */
&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;   /* SCREEN_CS：P0.02 */
};

/* LCD 背光：PWM0 OUT0 = P1.11 (SCREEN_BLK)，应用层按亮度百分比调占空比 */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	/* mipi-dbi + ST7789V 显示设备（MIPI-DBI-SPI 走 spi3，详见 lcd 显示.txt）。
	 * 参数参考 SDK shields/st7789v_generic 的 320x170 屏，上板按
	 * lcd 显示.txt【8】标定 x/y-offset 与 mdac。 */
	mipi_dbi0: mipi-dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi3>;
		dc-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;      /* SCREEN_DC：P0.03 */
		reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;   /* SCREEN_RES：P1.10 */
		write-only;

		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <16000000>;
			width = <320>;
			height = <172>;
			x-offset = <0>;
			y-offset = <35>;      /* 待上板实测微调（见 lcd 显示.txt 8.2） */
			vcom = <0x2b>;
			gctrl = <0x35>;
			vrhs = <0x0f>;
			vdvs = <0x20>;
			mdac = <0xA0>;        /* 实测:0x60 需整体转180°,取反 MY|MX=0xA0 后文字正立(0xE0 会整幅左右镜像,勿用) */
			gamma = <0x01>;
			colmod = <0x55>;      /* 16bit 65K */
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [52 a1];
			pvgam-param = [D0 00 02 07 0B 1A 31 54 40 29 12 12 12 17];
			nvgam-param = [D0 00 02 07 05 15 2D 44 44 1C 18 16 1C 1D];
			ram-param = [00 F8];
			rgb-param = [CD 08 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		};
	};
};

/*
 * 三模开关检测：MODE(P0.29) = SAADC AIN5，单端。
 *
 * 量程：内部 0.6V 参考 ÷ 增益 1/6 = 3.6V，覆盖 BLE 档的 3.3V 且留 300mV 余量。
 * 不用 VDD/4 参考：VDD 会随电池从 4.2V 掉到 3.3V，参考本身会漂。
 *
 * ⚠️ 通道子节点【必须命名为 channel】，否则 Zephyr 的 ADC API 宏取不到数据
 *    （adc-controller.yaml 的 child-binding 要求）。
 * ⚠️ input-positive 必须用 DT 头文件的 <NRF_SAADC_AIN5>（值为 5）。
 *    nRF HAL 里的 NRF_SAADC_INPUT_AIN5 是 6（HAL 中 0 表示断开，AIN0 从 1 起），
 *    两者差 1。若误写 6 会采到 AIN6 = P0.30 = COL3，现象是模式读数乱跳。
 *    只写 input-positive（不写 input-negative）即为 Zephyr 单端模式，
 *    负值由驱动钳到 0，不会触发驱动内部的 /2 修正。
 */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@5 {
		reg = <5>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;   /* P0.29 = MODE */
		zephyr,reference = "ADC_REF_INTERNAL";      /* 内部 0.6V */
		zephyr,gain = "ADC_GAIN_1_6";               /* 满量程 3.6V */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,resolution = <12>;
	};

	/*
	 * 电池电压采样：BAT_ADC(P0.31) = AIN7（详见 电池电压测量.txt）
	 * 电路：VBAT → R6(100k) → 节点(C29 100nF) → R8(100k) → Q1(NMOS) → GND
	 * 节点电压 = VBAT/2（1.5~2.1V），满量程 3.6V 覆盖。
	 * ⚠️ acquisition-time 40µs：分压源阻抗 ≈50kΩ 较高，采样窗口需加长。
	 */
	channel@7 {
		reg = <7>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;   /* P0.31 = BAT_ADC */
		zephyr,reference = "ADC_REF_INTERNAL";      /* 内部 0.6V */
		zephyr,gain = "ADC_GAIN_1_6";               /* 满量程 3.6V */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,resolution = <12>;
	};
};

/*
 * USB HID（三模开关 USB 档，详见 usb 通信.txt）
 *
 * nRF52840 内置 USB Full-Speed 设备控制器，原理图 D-/D+ 经 R23/R24(0Ω)
 * + USBLC6-2SC6 接入模块脚 29/31。板上无 VBUS 检测引脚，软件直接
 * usbd_enable()，插入 USB 线后由主机枚举。
 * hid_kbd 节点：zephyr,hid-device 绑定；报告描述符由 src/usb/usb_hid.c
 * 调 hid_device_register() 传入（与 BLE 共用 hid_keymap.c 里那份）。
 */
&usbd {
	status = "okay";

	/*
	 * 上位机控制口：CDC-ACM 虚拟串口（与 HID 键盘接口组成复合设备）。
	 * 主机侧 host_cli.py 通过该 COM 口下 AA55 帧 + protobuf 子集协议
	 * （hello/time_sync/theme_rgb，详见 src/usb/usb_host_cdc.c）。
	 *
	 * 为什么包一层 kb,usb-bus：nordic,nrf-usbd 绑定不带 usb bus 定义，
	 * 而 zephyr,cdc-acm-uart 有 on-bus: usb 断言，不能直接挂 &usbd。
	 * 包装节点只提供 bus: usb（绑定 dts/bindings/kb,usb-bus.yaml），
	 * 不映射驱动；CDC 类实例仍由 usb_hid.c 的 usbd_register_all_classes()
	 * 统一登记到同一个 usb_ctx 上下文。
	 */
	usb_class_bus: usb-class-bus {
		compatible = "kb,usb-bus";

		cdc_acm_uart0: cdc-acm-uart0 {
			compatible = "zephyr,cdc-acm-uart";
			label = "CDC0";
			tx-fifo-size = <512>;
			rx-fifo-size = <512>;
		};
	};
};

/ {
	hid_kbd: hid_kbd {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "keyboard";      /* 支持 Boot 协议 */
		/* ⚠️ 以下两个值必须是「线上总包长」（含 Report ID 字节），
		 * 驱动据此分配端点缓冲，缺一个字节都会导致报文被拒：
		 *   IN  = Report ID(1) + 键盘 8 字节 = 9
		 *   OUT = Report ID(1) + LED 1 字节  = 2 */
		in-report-size = <9>;
		in-polling-period-us = <1000>;   /* 1ms 轮询 */
		out-report-size = <2>;           /* NumLock LED 输出报告走 OUT 管道 */
		out-polling-period-us = <1000>;
	};
};

/* IP5306-I2C 电源管理芯片（SDA=P1.00 / SCL=P0.24，板载 10k 上拉） */
&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;   /* 400 kHz */

	ip5306: power-manager@75 {
		compatible = "injoinic,ip5306";
		reg = <0x75>;
		/* KEY 通常低有效（内部上拉，按下=拉低）；待 P08 实测确认极性 */
		wakeup-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(472)>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 DT_SIZE_K(472)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};

/* 灯带别名：应用层用 DT_ALIAS(led_strip) 取设备，不硬编码节点路径 */
/ {
	aliases {
		led-strip = &ws2812;
	};

	/* 电池采样 MOS 使能（NMOS 低边，高电平导通；详见 电池电压测量.txt）
	 * 自定义 binding：dts/bindings/kb,bat-adc-en.yaml（phandle-array 必须有
	 * binding 声明，DT 宏才会生成——zephyr_user 无 compatible 走不通） */
	bat_en: bat-adc-en {
		compatible = "kb,bat-adc-en";
		en-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
	};
};
